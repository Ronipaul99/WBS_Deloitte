{
  "AnalystContent": {
    "$defs": {
      "AnalystQuote": {
        "additionalProperties": false,
        "description": "Untrusted quote proposal; trusted Step 7 code supplies the final locator.",
        "properties": {
          "schema_version": {
            "const": "1.0",
            "default": "1.0",
            "title": "Schema Version",
            "type": "string"
          },
          "quote_id": {
            "format": "uuid",
            "title": "Quote Id",
            "type": "string"
          },
          "chunk_id": {
            "format": "uuid",
            "title": "Chunk Id",
            "type": "string"
          },
          "char_start": {
            "maximum": 10000000,
            "minimum": 0,
            "title": "Char Start",
            "type": "integer"
          },
          "char_end": {
            "maximum": 1000000,
            "minimum": 1,
            "title": "Char End",
            "type": "integer"
          },
          "exact_quote": {
            "maxLength": 8000,
            "minLength": 1,
            "pattern": "\\S",
            "title": "Exact Quote",
            "type": "string"
          }
        },
        "required": [
          "quote_id",
          "chunk_id",
          "char_start",
          "char_end",
          "exact_quote"
        ],
        "title": "AnalystQuote",
        "type": "object"
      },
      "CriticalFactClass": {
        "enum": [
          "other",
          "issuer",
          "capacity",
          "unit_count",
          "eligibility",
          "date",
          "financial_value",
          "emd",
          "pbg",
          "conditional_rule"
        ],
        "title": "CriticalFactClass",
        "type": "string"
      },
      "Fact": {
        "additionalProperties": false,
        "properties": {
          "schema_version": {
            "const": "1.0",
            "default": "1.0",
            "title": "Schema Version",
            "type": "string"
          },
          "fact_id": {
            "format": "uuid",
            "title": "Fact Id",
            "type": "string"
          },
          "category": {
            "$ref": "#/$defs/TenderCategory"
          },
          "critical_class": {
            "$ref": "#/$defs/CriticalFactClass"
          },
          "status": {
            "$ref": "#/$defs/FindingStatus"
          },
          "statement": {
            "maxLength": 8000,
            "minLength": 1,
            "pattern": "\\S",
            "title": "Statement",
            "type": "string"
          },
          "original_value": {
            "anyOf": [
              {
                "maxLength": 160,
                "minLength": 1,
                "pattern": "\\S",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Original Value"
          },
          "normalized_number": {
            "anyOf": [
              {
                "maxLength": 80,
                "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Normalized Number"
          },
          "unit": {
            "anyOf": [
              {
                "maxLength": 160,
                "minLength": 1,
                "pattern": "\\S",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Unit"
          },
          "currency": {
            "anyOf": [
              {
                "pattern": "^[A-Z]{3}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Currency"
          },
          "conditions": {
            "default": [],
            "items": {
              "maxLength": 8000,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            "maxItems": 16,
            "title": "Conditions",
            "type": "array"
          },
          "alternatives": {
            "default": [],
            "items": {
              "maxLength": 160,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            "maxItems": 8,
            "title": "Alternatives",
            "type": "array"
          },
          "evidence_ids": {
            "default": [],
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "maxItems": 32,
            "title": "Evidence Ids",
            "type": "array"
          }
        },
        "required": [
          "fact_id",
          "category",
          "critical_class",
          "status",
          "statement"
        ],
        "title": "Fact",
        "type": "object"
      },
      "FindingStatus": {
        "enum": [
          "supported",
          "unknown",
          "conflicting",
          "unsupported"
        ],
        "title": "FindingStatus",
        "type": "string"
      },
      "Requirement": {
        "additionalProperties": false,
        "properties": {
          "schema_version": {
            "const": "1.0",
            "default": "1.0",
            "title": "Schema Version",
            "type": "string"
          },
          "requirement_id": {
            "format": "uuid",
            "title": "Requirement Id",
            "type": "string"
          },
          "display_code": {
            "maxLength": 160,
            "minLength": 1,
            "pattern": "\\S",
            "title": "Display Code",
            "type": "string"
          },
          "obligation": {
            "maxLength": 8000,
            "minLength": 1,
            "pattern": "\\S",
            "title": "Obligation",
            "type": "string"
          },
          "status": {
            "$ref": "#/$defs/FindingStatus"
          },
          "responsible_party": {
            "anyOf": [
              {
                "maxLength": 160,
                "minLength": 1,
                "pattern": "\\S",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Responsible Party"
          },
          "deliverable": {
            "anyOf": [
              {
                "maxLength": 8000,
                "minLength": 1,
                "pattern": "\\S",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Deliverable"
          },
          "acceptance_criteria": {
            "default": [],
            "items": {
              "maxLength": 8000,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            "maxItems": 16,
            "title": "Acceptance Criteria",
            "type": "array"
          },
          "dependency_ids": {
            "default": [],
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "maxItems": 32,
            "title": "Dependency Ids",
            "type": "array"
          },
          "conditions": {
            "default": [],
            "items": {
              "maxLength": 8000,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            "maxItems": 16,
            "title": "Conditions",
            "type": "array"
          },
          "evidence_ids": {
            "default": [],
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "maxItems": 32,
            "title": "Evidence Ids",
            "type": "array"
          }
        },
        "required": [
          "requirement_id",
          "display_code",
          "obligation",
          "status"
        ],
        "title": "Requirement",
        "type": "object"
      },
      "TenderCategory": {
        "enum": [
          "overview",
          "issuer_parties",
          "scope_deliverables",
          "capacity_units",
          "eligibility",
          "technical",
          "dates_milestones",
          "financial_commercial",
          "securities_emd_pbg",
          "submission_evaluation_award",
          "obligations_conditions",
          "exclusions",
          "risks_conflicts_questions"
        ],
        "title": "TenderCategory",
        "type": "string"
      }
    },
    "additionalProperties": false,
    "description": "Model-writable extraction only. IDs are proposals, not durable identities.",
    "properties": {
      "schema_version": {
        "const": "1.0",
        "default": "1.0",
        "title": "Schema Version",
        "type": "string"
      },
      "facts": {
        "default": [],
        "items": {
          "$ref": "#/$defs/Fact"
        },
        "maxItems": 100,
        "title": "Facts",
        "type": "array"
      },
      "requirements": {
        "default": [],
        "items": {
          "$ref": "#/$defs/Requirement"
        },
        "maxItems": 100,
        "title": "Requirements",
        "type": "array"
      },
      "unresolved_categories": {
        "default": [],
        "items": {
          "$ref": "#/$defs/TenderCategory"
        },
        "maxItems": 13,
        "title": "Unresolved Categories",
        "type": "array"
      },
      "quotes": {
        "default": [],
        "items": {
          "$ref": "#/$defs/AnalystQuote"
        },
        "maxItems": 128,
        "title": "Quotes",
        "type": "array"
      },
      "no_facts_reason": {
        "anyOf": [
          {
            "enum": [
              "irrelevant_material",
              "no_extractable_tender_facts"
            ],
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "No Facts Reason"
      }
    },
    "title": "AnalystContent",
    "type": "object"
  },
  "AnalystArtifact": {
    "$defs": {
      "AnalystBatch": {
        "additionalProperties": false,
        "properties": {
          "schema_version": {
            "const": "1.0",
            "default": "1.0",
            "title": "Schema Version",
            "type": "string"
          },
          "version": {
            "const": "analyst_batch.v1",
            "default": "analyst_batch.v1",
            "title": "Version",
            "type": "string"
          },
          "batch": {
            "$ref": "#/$defs/ReadingBatch"
          },
          "extraction": {
            "$ref": "#/$defs/ExtractionRecord"
          },
          "completion": {
            "$ref": "#/$defs/BatchCompletion"
          }
        },
        "required": [
          "batch",
          "extraction",
          "completion"
        ],
        "title": "AnalystBatch",
        "type": "object"
      },
      "BatchCompletion": {
        "additionalProperties": false,
        "description": "Trusted controller receipt for a validated artifact, never a model assertion.",
        "properties": {
          "schema_version": {
            "const": "1.0",
            "default": "1.0",
            "title": "Schema Version",
            "type": "string"
          },
          "inventory_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Inventory Sha256",
            "type": "string"
          },
          "batch_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Batch Sha256",
            "type": "string"
          },
          "primary_chunk_ids": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "maxItems": 64,
            "minItems": 1,
            "title": "Primary Chunk Ids",
            "type": "array"
          },
          "artifact_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Artifact Sha256",
            "type": "string"
          },
          "truncated": {
            "const": false,
            "default": false,
            "title": "Truncated",
            "type": "boolean"
          }
        },
        "required": [
          "inventory_sha256",
          "batch_sha256",
          "primary_chunk_ids",
          "artifact_sha256"
        ],
        "title": "BatchCompletion",
        "type": "object"
      },
      "CriticalFactClass": {
        "enum": [
          "other",
          "issuer",
          "capacity",
          "unit_count",
          "eligibility",
          "date",
          "financial_value",
          "emd",
          "pbg",
          "conditional_rule"
        ],
        "title": "CriticalFactClass",
        "type": "string"
      },
      "EvidenceReference": {
        "additionalProperties": false,
        "properties": {
          "schema_version": {
            "const": "1.0",
            "default": "1.0",
            "title": "Schema Version",
            "type": "string"
          },
          "evidence_id": {
            "format": "uuid",
            "title": "Evidence Id",
            "type": "string"
          },
          "scope": {
            "$ref": "#/$defs/SourceScope"
          },
          "chunk_id": {
            "format": "uuid",
            "title": "Chunk Id",
            "type": "string"
          },
          "chunk_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Chunk Sha256",
            "type": "string"
          },
          "physical_pages": {
            "items": {
              "maximum": 1000000,
              "minimum": 1,
              "type": "integer"
            },
            "maxItems": 500,
            "minItems": 1,
            "title": "Physical Pages",
            "type": "array"
          },
          "heading_path": {
            "default": [],
            "items": {
              "maxLength": 160,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            "maxItems": 16,
            "title": "Heading Path",
            "type": "array"
          },
          "exact_quote": {
            "maxLength": 8000,
            "minLength": 1,
            "pattern": "\\S",
            "title": "Exact Quote",
            "type": "string"
          },
          "char_start": {
            "maximum": 10000000,
            "minimum": 0,
            "title": "Char Start",
            "type": "integer"
          },
          "char_end": {
            "maximum": 1000000,
            "minimum": 1,
            "title": "Char End",
            "type": "integer"
          },
          "offset_unit": {
            "const": "unicode_codepoint",
            "default": "unicode_codepoint",
            "title": "Offset Unit",
            "type": "string"
          },
          "printed_page_label": {
            "anyOf": [
              {
                "maxLength": 160,
                "minLength": 1,
                "pattern": "\\S",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Printed Page Label"
          },
          "table_id": {
            "anyOf": [
              {
                "maxLength": 160,
                "minLength": 1,
                "pattern": "\\S",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Table Id"
          },
          "row_id": {
            "anyOf": [
              {
                "maxLength": 160,
                "minLength": 1,
                "pattern": "\\S",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Row Id"
          }
        },
        "required": [
          "evidence_id",
          "scope",
          "chunk_id",
          "chunk_sha256",
          "physical_pages",
          "exact_quote",
          "char_start",
          "char_end"
        ],
        "title": "EvidenceReference",
        "type": "object"
      },
      "ExtractionRecord": {
        "additionalProperties": false,
        "properties": {
          "schema_version": {
            "const": "1.0",
            "default": "1.0",
            "title": "Schema Version",
            "type": "string"
          },
          "version": {
            "const": "extraction.v1",
            "default": "extraction.v1",
            "title": "Version",
            "type": "string"
          },
          "binding": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Binding",
            "type": "string"
          },
          "origin_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Origin Sha256",
            "type": "string"
          },
          "findings": {
            "$ref": "#/$defs/FactBatch"
          },
          "evidence": {
            "default": [],
            "items": {
              "$ref": "#/$defs/EvidenceReference"
            },
            "maxItems": 128,
            "title": "Evidence",
            "type": "array"
          },
          "aliases": {
            "default": [],
            "items": {
              "$ref": "#/$defs/FindingAlias"
            },
            "maxItems": 200,
            "title": "Aliases",
            "type": "array"
          },
          "no_facts_reason": {
            "anyOf": [
              {
                "enum": [
                  "irrelevant_material",
                  "no_extractable_tender_facts"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "No Facts Reason"
          },
          "semantic_support": {
            "const": "analyst_asserted_not_independently_verified",
            "default": "analyst_asserted_not_independently_verified",
            "title": "Semantic Support",
            "type": "string"
          }
        },
        "required": [
          "binding",
          "origin_sha256",
          "findings"
        ],
        "title": "ExtractionRecord",
        "type": "object"
      },
      "Fact": {
        "additionalProperties": false,
        "properties": {
          "schema_version": {
            "const": "1.0",
            "default": "1.0",
            "title": "Schema Version",
            "type": "string"
          },
          "fact_id": {
            "format": "uuid",
            "title": "Fact Id",
            "type": "string"
          },
          "category": {
            "$ref": "#/$defs/TenderCategory"
          },
          "critical_class": {
            "$ref": "#/$defs/CriticalFactClass"
          },
          "status": {
            "$ref": "#/$defs/FindingStatus"
          },
          "statement": {
            "maxLength": 8000,
            "minLength": 1,
            "pattern": "\\S",
            "title": "Statement",
            "type": "string"
          },
          "original_value": {
            "anyOf": [
              {
                "maxLength": 160,
                "minLength": 1,
                "pattern": "\\S",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Original Value"
          },
          "normalized_number": {
            "anyOf": [
              {
                "maxLength": 80,
                "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Normalized Number"
          },
          "unit": {
            "anyOf": [
              {
                "maxLength": 160,
                "minLength": 1,
                "pattern": "\\S",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Unit"
          },
          "currency": {
            "anyOf": [
              {
                "pattern": "^[A-Z]{3}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Currency"
          },
          "conditions": {
            "default": [],
            "items": {
              "maxLength": 8000,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            "maxItems": 16,
            "title": "Conditions",
            "type": "array"
          },
          "alternatives": {
            "default": [],
            "items": {
              "maxLength": 160,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            "maxItems": 8,
            "title": "Alternatives",
            "type": "array"
          },
          "evidence_ids": {
            "default": [],
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "maxItems": 32,
            "title": "Evidence Ids",
            "type": "array"
          }
        },
        "required": [
          "fact_id",
          "category",
          "critical_class",
          "status",
          "statement"
        ],
        "title": "Fact",
        "type": "object"
      },
      "FactBatch": {
        "additionalProperties": false,
        "description": "Analyst output; scope and evidence locators are never model-selected.",
        "properties": {
          "schema_version": {
            "const": "1.0",
            "default": "1.0",
            "title": "Schema Version",
            "type": "string"
          },
          "facts": {
            "default": [],
            "items": {
              "$ref": "#/$defs/Fact"
            },
            "maxItems": 100,
            "title": "Facts",
            "type": "array"
          },
          "requirements": {
            "default": [],
            "items": {
              "$ref": "#/$defs/Requirement"
            },
            "maxItems": 100,
            "title": "Requirements",
            "type": "array"
          },
          "unresolved_categories": {
            "default": [],
            "items": {
              "$ref": "#/$defs/TenderCategory"
            },
            "maxItems": 13,
            "title": "Unresolved Categories",
            "type": "array"
          }
        },
        "title": "FactBatch",
        "type": "object"
      },
      "FindingAlias": {
        "additionalProperties": false,
        "properties": {
          "schema_version": {
            "const": "1.0",
            "default": "1.0",
            "title": "Schema Version",
            "type": "string"
          },
          "origin_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Origin Sha256",
            "type": "string"
          },
          "proposed_id": {
            "format": "uuid",
            "title": "Proposed Id",
            "type": "string"
          },
          "stable_id": {
            "format": "uuid",
            "title": "Stable Id",
            "type": "string"
          }
        },
        "required": [
          "origin_sha256",
          "proposed_id",
          "stable_id"
        ],
        "title": "FindingAlias",
        "type": "object"
      },
      "FindingStatus": {
        "enum": [
          "supported",
          "unknown",
          "conflicting",
          "unsupported"
        ],
        "title": "FindingStatus",
        "type": "string"
      },
      "GapFinding": {
        "additionalProperties": false,
        "properties": {
          "schema_version": {
            "const": "1.0",
            "default": "1.0",
            "title": "Schema Version",
            "type": "string"
          },
          "category": {
            "$ref": "#/$defs/TenderCategory"
          },
          "state": {
            "enum": [
              "unknown_not_searched",
              "not_found_within_allowance",
              "conflicting",
              "incomplete_reading",
              "budget_exhausted",
              "search_unavailable",
              "candidate_found_unverified"
            ],
            "title": "State",
            "type": "string"
          },
          "absence_proven": {
            "const": false,
            "default": false,
            "title": "Absence Proven",
            "type": "boolean"
          },
          "analyst_reported_unresolved": {
            "default": false,
            "title": "Analyst Reported Unresolved",
            "type": "boolean"
          }
        },
        "required": [
          "category",
          "state"
        ],
        "title": "GapFinding",
        "type": "object"
      },
      "GapRecord": {
        "additionalProperties": false,
        "properties": {
          "schema_version": {
            "const": "1.0",
            "default": "1.0",
            "title": "Schema Version",
            "type": "string"
          },
          "version": {
            "const": "analyst_gap.v1",
            "default": "analyst_gap.v1",
            "title": "Version",
            "type": "string"
          },
          "binding": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Binding",
            "type": "string"
          },
          "inventory_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Inventory Sha256",
            "type": "string"
          },
          "round": {
            "maximum": 2,
            "minimum": 0,
            "title": "Round",
            "type": "integer"
          },
