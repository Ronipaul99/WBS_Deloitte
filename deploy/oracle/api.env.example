# Live HTTPS deployment; real api.env stays untracked and owner-only.
# During the initial HTTP bootstrap only, use http:// instead.
PUBLIC_UI_URL=https://wbsgenie.duckdns.org
CORS_ORIGINS=https://wbsgenie.duckdns.org
# Generate two independent values: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_JWT_SECRET=
AUTH_AUDIT_SECRET=
# Do not put migration-owner credentials in the API container.
