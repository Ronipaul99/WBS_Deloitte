# Keep actual credentials only in the untracked worker.env on the VM.
APP_ENV=development
AUTH_MODE=development
DATABASE_URL=postgresql://RUNTIME_USER:PASSWORD@NEON_POOLED_HOST/neondb?sslmode=require
DATABASE_USE_NULL_POOL=true
REDIS_URL=redis://:GENERATED_PASSWORD@redis:6379/0
STORAGE_BACKEND=s3
OBJECT_STORAGE_BUCKET=YOUR_BUCKET
AWS_ENDPOINT_URL_S3=https://YOUR_S3_ENDPOINT
AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_SECRET_KEY
AWS_REGION=us-east-2
UPLOAD_ROOT=/home/wbs/state/uploads
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
TASKS_EAGER=false
AUTO_CREATE_TABLES=false
DOCUMENT_INGESTION_ENABLED=false
# Opt in only for the private development stack after building and verifying the worker.
DOCUMENT_INGESTION_LOCAL_DEVELOPMENT=false
# Non-secret migration role identity; never copy the migration URL/password to this VM.
DATABASE_MIGRATION_ROLE_NAME=YOUR_MIGRATION_ROLE
DOCUMENT_RECONCILIATION_REPAIRS_ENABLED=false
DOCUMENT_RETENTION_ENABLED=false
DOCUMENT_ORPHAN_CLEANUP_ENABLED=false
