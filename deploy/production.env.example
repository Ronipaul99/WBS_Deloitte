# Public/runtime configuration only. Values in angle brackets are deployment inputs.
APP_ENV=production
AUTH_MODE=hybrid
AUTO_CREATE_TABLES=false
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_REFRESH_TOKEN_DAYS=7
CORS_ORIGINS=https://<ui-host>
PUBLIC_UI_URL=https://<ui-host>
FORWARDED_ALLOW_IPS=<reviewed-proxy-cidr-list>
READINESS_REQUIRE_MIGRATION_HEAD=true
METRICS_ENABLED=true
PASSWORD_RECOVERY_ENABLED=true
TENANT_INVITATIONS_ENABLED=true
EMAIL_PROVIDER=smtp
EMAIL_FROM=no-reply@<verified-domain>
SMTP_HOST=<smtp-host>
SMTP_PORT=587
SMTP_SECURITY=starttls
REFRESH_SESSION_RETENTION_DAYS=30
PASSWORD_RESET_RETENTION_DAYS=30
TENANT_INVITATION_RETENTION_DAYS=30
AUTH_EVENT_RETENTION_DAYS=365
TEMPORARY_FILE_RETENTION_HOURS=24
MAINTENANCE_BATCH_SIZE=1000
OIDC_ISSUER=https://<provider-issuer>
OIDC_AUDIENCE=<registered-client-id-or-audience>
OIDC_DISCOVERY_URL=https://<provider-issuer>/.well-known/openid-configuration
OIDC_AUTHORIZATION_ENDPOINT=https://<reviewed-authorization-endpoint>
OIDC_TOKEN_ENDPOINT=https://<reviewed-token-endpoint>
OIDC_JWKS_URL=https://<reviewed-jwks-endpoint>
OIDC_CLIENT_ID=<registered-client-id>
OIDC_REDIRECT_URI=https://<api-host>/api/v1/auth/sso/callback
OIDC_PROVIDER_ID=<stable-provider-slug>
OIDC_PROVIDER_TENANT_ID=<approved-directory-id>
OIDC_TENANT_CLAIM=tid
OIDC_EMAIL_CLAIM=email
OIDC_EMAIL_VERIFIED_CLAIM=email_verified
OIDC_NAME_CLAIM=name
OIDC_ALLOWED_RETURN_PATHS=/sso/callback
OIDC_STATE_RETENTION_DAYS=7

# Secret-manager injection only. Never put real values in this file.
DATABASE_URL=<pooled-runtime-secret-reference>
DIRECT_DATABASE_URL=<direct-migration-secret-reference>
AUTH_JWT_SECRET=<jwt-secret-reference>
AUTH_AUDIT_SECRET=<audit-secret-reference>
METRICS_BEARER_TOKEN=<metrics-token-reference>
SMTP_USERNAME=<smtp-user-secret-reference>
SMTP_PASSWORD=<smtp-password-secret-reference>
OIDC_CLIENT_SECRET=<oidc-client-secret-reference>
OIDC_STATE_SECRET=<independent-oidc-state-secret-reference>
