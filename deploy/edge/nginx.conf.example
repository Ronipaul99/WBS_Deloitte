# Reference edge policy. Replace hostnames, certificate paths, upstreams, and trusted
# monitoring networks during the platform review. Do not deploy this file unchanged.

worker_processes auto;
pid /tmp/nginx.pid;

events {
    worker_connections 2048;
}

http {
    include /etc/nginx/mime.types;
    # Never record OAuth authorization codes, state, or provider errors from a
    # callback query string. Keep the same path-only policy at any outer load balancer.
    log_format path_only '$remote_addr - $remote_user [$time_local] '
                         '"$request_method $uri $server_protocol" $status $body_bytes_sent '
                         '"$http_referer" "$http_user_agent"';
    access_log /dev/stdout path_only;
    server_tokens off;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:TLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    limit_req_zone $binary_remote_addr zone=login:10m rate=5r/m;
    limit_req_zone $binary_remote_addr zone=refresh:10m rate=30r/m;
    limit_req_zone $binary_remote_addr zone=sso:10m rate=10r/m;
    limit_req_zone $binary_remote_addr zone=recovery:10m rate=5r/m;
    limit_req_zone $binary_remote_addr zone=invitation:10m rate=10r/m;
    limit_req_zone $binary_remote_addr zone=upload:10m rate=10r/m;
    limit_req_zone $binary_remote_addr zone=generation:10m rate=10r/m;

    upstream wbs_api {
        server api:8000;
        keepalive 32;
    }

    upstream wbs_ui {
        server ui:8080;
        keepalive 16;
    }

    server {
        listen 80;
        server_name wbs.example.com api.wbs.example.com;
        return 308 https://$host$request_uri;
    }

    server {
        listen 443 ssl http2;
        server_name api.wbs.example.com;
        ssl_certificate /run/secrets/tls/fullchain.pem;
        ssl_certificate_key /run/secrets/tls/privkey.pem;
        client_max_body_size 26m;
        client_body_timeout 15s;
        keepalive_timeout 30s;
        send_timeout 60s;

        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "no-referrer" always;

        # Overwrite, rather than append, untrusted forwarding headers. If a managed load
        # balancer precedes this edge, add only its reviewed CIDRs with set_real_ip_from.
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;

        location = /api/v1/auth/login {
            limit_req zone=login burst=3 nodelay;
            proxy_pass http://wbs_api;
        }

        location = /api/v1/auth/refresh {
            limit_req zone=refresh burst=10 nodelay;
            proxy_pass http://wbs_api;
        }

        location ~ ^/api/v1/auth/sso/(start|callback)$ {
            limit_req zone=sso burst=5 nodelay;
            # Nginx error logs cannot redact query strings. The application emits
            # structured, path-only failures for these two endpoints instead.
            error_log /dev/null crit;
            proxy_pass http://wbs_api;
        }

        location ~ ^/api/v1/auth/(forgot-password|reset-password)$ {
            limit_req zone=recovery burst=3 nodelay;
            proxy_pass http://wbs_api;
        }

        location ~ ^/api/v1/tenants/[^/]+/invitations {
            limit_req zone=invitation burst=5 nodelay;
            proxy_pass http://wbs_api;
        }

        location = /api/v1/auth/accept-invitation {
            limit_req zone=invitation burst=5 nodelay;
            proxy_pass http://wbs_api;
        }

        location ~ ^/api/v1/tenants/[^/]+/(projects/[^/]+/documents|templates)$ {
            limit_req zone=upload burst=3 nodelay;
            proxy_pass http://wbs_api;
        }

        location ~ ^/api/v1/tenants/[^/]+/(projects/[^/]+/generations|documents/[^/]+/summary|wbs/[^/]+/(validations|exports)|jobs/[^/]+/retry)$ {
            limit_req zone=generation burst=3 nodelay;
            proxy_pass http://wbs_api;
        }

        location = /api/v1/health/metrics {
            # Replace deny-only with the reviewed monitoring CIDR on a private path.
            deny all;
            proxy_pass http://wbs_api;
        }

        location / {
            proxy_pass http://wbs_api;
        }
    }

    server {
        listen 443 ssl http2;
        server_name wbs.example.com;
        ssl_certificate /run/secrets/tls/fullchain.pem;
        ssl_certificate_key /run/secrets/tls/privkey.pem;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_pass_request_headers on;

        location / {
            proxy_pass http://wbs_ui;
        }
    }
}
