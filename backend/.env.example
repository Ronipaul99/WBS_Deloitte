APP_ENV=development

# Local SQLite development. Replace these values with the Neon examples below.
DATABASE_URL=sqlite+aiosqlite:///./wbs.db
DIRECT_DATABASE_URL=
DATABASE_USE_NULL_POOL=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_RECYCLE_SECONDS=300

# Neon runtime URL: copy the pooled URL whose hostname contains "-pooler".
# DATABASE_URL=postgresql://USER:PASSWORD@ep-EXAMPLE-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Neon migration URL: copy the direct URL whose hostname does not contain "-pooler".
# DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@ep-EXAMPLE.REGION.aws.neon.tech/neondb?sslmode=require
# DATABASE_USE_NULL_POOL=true

REDIS_URL=redis://localhost:6379/0
TASKS_EAGER=true
# Use true only for throwaway SQLite development. Use Alembic for Neon.
AUTO_CREATE_TABLES=true
UPLOAD_ROOT=.data/uploads
# Use "local" for offline development and "s3" for Neon Object Storage.
STORAGE_BACKEND=local
OBJECT_STORAGE_BUCKET=assets
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
# Use a newly generated credential and keep it only in a secret manager or untracked .env.
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
OBJECT_STORAGE_CONNECT_TIMEOUT_SECONDS=5
OBJECT_STORAGE_READ_TIMEOUT_SECONDS=60
OBJECT_STORAGE_MAX_ATTEMPTS=3
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_BYTES=26214400
MAX_REQUEST_BODY_BYTES=27262976
# Passed through to Uvicorn. List only the reverse proxies allowed to set client addresses.
FORWARDED_ALLOW_IPS=127.0.0.1
READINESS_REQUIRE_MIGRATION_HEAD=false

# Keep disabled locally. Production requires an independent secret-managed bearer token.
METRICS_ENABLED=false
METRICS_BEARER_TOKEN=

# Keep disabled until the worker, model, PostgreSQL, S3, Redis, and scanner are ready.
# Development ingestion requires the explicit opt-in below and the same real dependencies.
DOCUMENT_INGESTION_ENABLED=false
# Explicit opt-in for a local API connected to the private VM services over SSH.
# Requires the same S3, PostgreSQL, scanner, model pins, and non-eager tasks as ingestion.
DOCUMENT_INGESTION_LOCAL_DEVELOPMENT=false
# Development workers may use this non-secret role name instead of DIRECT_DATABASE_URL.
DATABASE_MIGRATION_ROLE_NAME=
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384
EMBEDDING_BATCH_SIZE=32
# Package this read-only directory in the worker image only, never the API image.
EMBEDDING_MODEL_PATH=/opt/wbs-models/bge-small-en-v1.5
# Repository-pinned immutable worker artifact. Deployment approval remains an external gate.
EMBEDDING_MODEL_REVISION=aa8f8b060edb00e03bfdd08813a2949946c8ba55
EMBEDDING_MODEL_MANIFEST_SHA256=609e3f5b2f42b5c302c9fd86344b7c9f1cb498fa2f29826b1265da284dc18ca0
EMBEDDING_FORMATTING_VERSION=bge-small-en-v1.5-format-v1
EMBEDDING_TOKENIZER_REVISION=aa8f8b060edb00e03bfdd08813a2949946c8ba55
EMBEDDING_TOKENIZER_SHA256=d241a60d5e8f04cc1b2b3e9ef7a4921b27bf526d9f6050ab90f9267a1f9e5c66
EMBEDDING_MAX_TEXT_CHARACTERS=100000
EMBEDDING_MAX_CONCURRENT_BATCHES=1
EMBEDDING_CPU_THREADS=2
DOCUMENT_PROCESSING_TIMEOUT_SECONDS=900
DOCUMENT_MAX_PDF_PAGES=500
DOCUMENT_MAX_WORKSHEETS=100
DOCUMENT_MAX_ROWS_PER_SHEET=100000
DOCUMENT_MAX_EXTRACTED_CHARACTERS=10000000
DOCUMENT_MAX_EXTRACTED_BLOCKS=100000
DOCUMENT_MAX_BLOCK_CHARACTERS=100000
DOCUMENT_MAX_HEADING_DEPTH=16
DOCUMENT_MAX_HEADING_LABEL_CHARACTERS=500
DOCUMENT_MAX_EXTRACTION_WARNINGS=100
DOCUMENT_MAX_METADATA_FIELDS=16
DOCUMENT_MAX_METADATA_DEPTH=3
DOCUMENT_MAX_METADATA_VALUE_CHARACTERS=1000
DOCUMENT_MAX_METADATA_LIST_ITEMS=100
DOCUMENT_MAX_SHEET_NAME_CHARACTERS=160
DOCUMENT_MAX_ARCHIVE_ENTRIES=10000
DOCUMENT_MAX_ARCHIVE_COMPRESSED_BYTES=26214400
DOCUMENT_MAX_ARCHIVE_UNCOMPRESSED_BYTES=209715200
DOCUMENT_MAX_ARCHIVE_ENTRY_BYTES=67108864
DOCUMENT_MAX_ARCHIVE_EXPANSION_RATIO=100
DOCUMENT_MAX_SPREADSHEET_COLUMNS=1000
DOCUMENT_MAX_SPREADSHEET_CELLS=1000000
DOCUMENT_MAX_MERGED_RANGES=10000
DOCUMENT_MAX_CSV_COLUMNS=1000
DOCUMENT_MAX_CSV_FIELD_CHARACTERS=100000
PDF_MAX_CONTENT_STREAM_BYTES=16777216
PDF_NATIVE_TEXT_MIN_CHARACTERS=32
PDF_REPEATED_MARGIN_MIN_PAGES=3
PDF_REPEATED_MARGIN_MIN_RATIO=0.8
PDF_MARGIN_BAND_RATIO=0.12
PDF_REPEATED_MARGIN_MAX_CHARACTERS=160
PDF_PARSER_TIMEOUT_SECONDS=120
DOCUMENT_CHUNK_TARGET_TOKENS=400
DOCUMENT_CHUNK_OVERLAP_TOKENS=50
DOCUMENT_CHUNK_MAX_TOKENS=480
DOCUMENT_CHUNK_FORMATTING_HEADROOM_TOKENS=32
DOCUMENT_MAX_CHUNKS=100000
DOCUMENT_MAX_CHUNK_SOURCE_REFERENCES=2048
OCR_ENABLED=true
OCR_LANGUAGES=eng
OCR_TIMEOUT_SECONDS=300
OCR_MAX_OUTPUT_BYTES=52428800
OCR_MAX_TEMPORARY_BYTES=268435456
OCR_PROCESS_OUTPUT_MAX_BYTES=65536
OCR_CPU_LIMIT_SECONDS=300
OCR_MEMORY_LIMIT_BYTES=2147483648
# Set both to the exact approved versions installed in the release worker image.
OCRMYPDF_EXPECTED_VERSION=APPROVED_EXACT_VERSION
TESSERACT_EXPECTED_VERSION=APPROVED_EXACT_VERSION
MALWARE_SCAN_REQUIRED=true
# Inject the private ClamAV service host through the release environment.
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_CONNECT_TIMEOUT_SECONDS=3
CLAMAV_SCAN_TIMEOUT_SECONDS=60
CLAMAV_RESPONSE_MAX_BYTES=4096
# Provision this absolute path in the worker image with owner-only access.
DOCUMENT_PROCESSING_TEMP_ROOT=/var/lib/wbs/processing
# Durable ingestion delivery and retry policy. Release workers must remain non-eager.
DOCUMENT_INGESTION_MAX_ATTEMPTS=5
DOCUMENT_INGESTION_RETRY_BASE_SECONDS=5
DOCUMENT_INGESTION_RETRY_MAX_SECONDS=300
DOCUMENT_DISPATCH_PUBLISH_TIMEOUT_SECONDS=10
DOCUMENT_DISPATCH_LEASE_SECONDS=60
DOCUMENT_RECONCILIATION_STALE_SECONDS=900
DOCUMENT_RECONCILIATION_BATCH_SIZE=100

# Durable deletion mechanics. These are operational bounds, not retention policy.
DOCUMENT_DELETION_MAX_ATTEMPTS=5
DOCUMENT_DELETION_RETRY_BASE_SECONDS=5
DOCUMENT_DELETION_RETRY_MAX_SECONDS=300
DOCUMENT_DELETION_LEASE_SECONDS=60
DOCUMENT_DELETION_STALE_SECONDS=900
DOCUMENT_LIFECYCLE_BATCH_SIZE=100
DOCUMENT_RECONCILIATION_REPAIRS_ENABLED=false

# Disabled until privacy/legal owners approve every duration. No release defaults are supplied.
DOCUMENT_RETENTION_ENABLED=false
DOCUMENT_RETENTION_FAILED_RUN_DAYS=
DOCUMENT_RETENTION_CANCELLED_RUN_DAYS=
DOCUMENT_RETENTION_SUPERSEDED_RUN_DAYS=
DOCUMENT_RETENTION_JOB_DAYS=
DOCUMENT_RETENTION_MALWARE_EVENT_DAYS=
DOCUMENT_RETENTION_TOMBSTONE_DAYS=
DOCUMENT_RETENTION_STALE_WORKSPACE_HOURS=
# Destructive orphan removal additionally requires operator-approved repair mode.
DOCUMENT_ORPHAN_CLEANUP_ENABLED=false
DOCUMENT_ORPHAN_MINIMUM_AGE_HOURS=

# Scheduled maintenance retention. Approval of these periods is an operations/privacy decision.
REFRESH_SESSION_RETENTION_DAYS=30
AUTH_EVENT_RETENTION_DAYS=365
TEMPORARY_FILE_RETENTION_HOURS=24
MAINTENANCE_BATCH_SIZE=1000

# Development identity. The bypass is forbidden when APP_ENV=production.
DEV_USER_ID=00000000-0000-0000-0000-000000000001
DEV_TENANT_ID=00000000-0000-0000-0000-000000000001
# Optional only for local/test seeding. Do not use a shared or production password.
DEV_USER_PASSWORD=

# Modes: development (bypass), local, oidc, or hybrid (local plus SSO).
AUTH_MODE=development

# Both are required for every non-development auth mode and must be independent values:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_JWT_SECRET=
AUTH_AUDIT_SECRET=
AUTH_JWT_ISSUER=wbs-generator-api
AUTH_JWT_AUDIENCE=wbs-generator-ui
AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_REFRESH_TOKEN_DAYS=7
AUTH_REFRESH_COOKIE_NAME=wbs_refresh
# Must be true behind HTTPS in production.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_LOGIN_WINDOW_MINUTES=15
AUTH_LOGIN_SUBJECT_LIMIT=5
AUTH_LOGIN_IP_LIMIT=20

# Password recovery is disabled until email delivery and the public UI origin are configured.
PASSWORD_RECOVERY_ENABLED=false
PUBLIC_UI_URL=http://127.0.0.1:5173
PASSWORD_RESET_MINUTES=30
PASSWORD_RESET_WINDOW_MINUTES=15
PASSWORD_RESET_SUBJECT_LIMIT=3
PASSWORD_RESET_IP_LIMIT=20
PASSWORD_RESET_RETENTION_DAYS=30

# Tenant invitations use the same public UI origin and email provider.
TENANT_INVITATIONS_ENABLED=false
TENANT_INVITATION_HOURS=72
TENANT_INVITATION_RETENTION_DAYS=30
TENANT_INVITATION_RESEND_WINDOW_MINUTES=60
TENANT_INVITATION_RESEND_LIMIT=5

# Vendor-neutral SMTP delivery. EMAIL_PROVIDER=test is accepted only under APP_ENV=test.
EMAIL_PROVIDER=smtp
EMAIL_FROM=no-reply@example.com
EMAIL_DELIVERY_TIMEOUT_SECONDS=10
EMAIL_DELIVERY_RETRIES=2
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# starttls (usually port 587), tls (usually port 465), or none (development only).
SMTP_SECURITY=starttls

# SSO settings used by oidc/hybrid mode.
OIDC_ISSUER=
OIDC_AUDIENCE=
# Discovery is derived from OIDC_ISSUER when omitted. Production should set and review it.
OIDC_DISCOVERY_URL=
# Production pins all three discovered endpoints to prevent metadata drift or SSRF.
OIDC_AUTHORIZATION_ENDPOINT=
OIDC_TOKEN_ENDPOINT=
OIDC_JWKS_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/sso/callback
# Generate independently: python -c "import secrets; print(secrets.token_urlsafe(48))"
OIDC_STATE_SECRET=
OIDC_STATE_COOKIE_NAME=wbs_oidc_state
OIDC_STATE_MINUTES=10
OIDC_STATE_RETENTION_DAYS=7
OIDC_PROVIDER_ID=enterprise_oidc
OIDC_PROVIDER_TENANT_ID=
OIDC_TENANT_CLAIM=tid
OIDC_EMAIL_CLAIM=email
OIDC_EMAIL_VERIFIED_CLAIM=email_verified
OIDC_NAME_CLAIM=name
OIDC_SCOPES=openid email profile
OIDC_ALLOWED_RETURN_PATHS=/sso/callback
